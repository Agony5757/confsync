# GitHub OAuth App credentials (https://github.com/settings/developers)
# Authorization callback URL: https://confsync.tool.chenzhaoyun.com/auth/github/callback
CONFSYNC_GITHUB_CLIENT_ID=Ov23li...
CONFSYNC_GITHUB_CLIENT_SECRET=...
# Self-hosted Gitea login (optional) — create an OAuth2 application in Gitea:
# Settings → Applications → OAuth2 Applications
# (https://git.example.com/user/settings/applications)
# Redirect URL: https://confsync.tool.chenzhaoyun.com/auth/gitea/callback
# Leaving Gitea unconfigured keeps the server GitHub-only.
CONFSYNC_GITEA_URL=https://git.example.com
CONFSYNC_GITEA_CLIENT_ID=
CONFSYNC_GITEA_CLIENT_SECRET=
CONFSYNC_EXTERNAL_URL=https://confsync.tool.chenzhaoyun.com
# Comma-separated logins (GitHub or Gitea) allowed to sign in. Leave empty for
# bootstrap: the first user to log in becomes admin and is allowlisted
# automatically.
CONFSYNC_ALLOWED_USERS=Agony5757
